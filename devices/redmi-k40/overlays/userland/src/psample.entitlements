<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- psample (src/psample.c) looks at other processes' threads from the outside: their task ports, as debugserver
     (github.com/xiongnemo/ios-alioth-devtools) is allowed them -->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>com.apple.system-task-ports</key>
	<true/>
	<key>com.apple.system-task-ports.control</key>
	<true/>
	<key>com.apple.system-task-ports.read</key>
	<true/>
	<key>com.apple.private.cs.debugger</key>
	<true/>
	<key>run-unsigned-code</key>
	<true/>
</dict>
</plist>
