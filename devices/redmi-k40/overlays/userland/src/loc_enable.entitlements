<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- locationd's names (strings of iOS 16.5's /usr/libexec/locationd): the master switch is its "big switch" -->
	<key>com.apple.locationd.bigswitch</key>
	<true/>
	<key>com.apple.locationd.status</key>
	<true/>
	<key>com.apple.locationd.authorizeapplications</key>
	<true/>
	<!-- tccd's: setting an application's privacy answers, as Settings does (loc_enable --tcc, test roots) -->
	<key>com.apple.private.tcc.manager</key>
	<true/>
</dict>
</plist>
