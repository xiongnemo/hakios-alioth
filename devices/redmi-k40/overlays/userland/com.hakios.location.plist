<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Location Services' own switch on at every boot (src/loc_enable.m), as the Setup Assistant turns it on on an
	     iPhone that is set up: /private/var, where locationd keeps it, starts empty. Then Settings has Location
	     Services and applications get a location (Wi-Fi positioning through Apple: VERIFIED 2026-10-31, OSS Weather) -->
	<key>Label</key>
	<string>com.hakios.location</string>
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/loc_enable</string>
		<string>1</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
