+/*
+ * (redmi-k40) A NAME "*SUFFIX" in kern.exec_inject names every program whose directory's name ends in SUFFIX:
+ * "*.app" and "*.appex" are all the applications and their extensions, which RunningBoard starts from wherever
+ * they were installed. The path is the one looked up, its last component the program's file name.
+ */
+static bool
+exec_inject_in_bundle(struct image_params *imgp, const char *suffix, size_t length)
+{
+	const char *start = imgp->ip_ndp->ni_cnd.cn_pnbuf;
+	const char *name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+
+	if (start == NULL || name == NULL || length == 0 || name < start + length + 1 || name[-1] != '/') {
+		return false;
+	}
+	return strncmp(name - 1 - length, suffix, length) == 0;
+}
